{
  "name": "hymn",
  "productName": "Hymn",
  "version": "0.1.0",
  "description": "A sidebar music widget for macOS that plays your YouTube playlist, YouTube mixes and search results.",
  "author": "Hymn contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/ragnox/hymn.git"
  },
  "homepage": "https://github.com/ragnox/hymn#readme",
  "bugs": {
    "url": "https://github.com/ragnox/hymn/issues"
  },
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:ui": "node --test --test-concurrency=1 \"test/ui/*.test.js\"",
    "icons": "node scripts/make-icons.js",
    "dist": "node scripts/build-mac.js",
    "dist:dir": "node scripts/build-mac.js --dir"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "io.github.ragnox.hymn",
    "productName": "Hymn",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "artifactName": "Hymn-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": true,
        "NSHumanReadableCopyright": "Hymn"
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Hymn"
    },
    "electronLanguages": [
      "en",
      "de"
    ]
  }
}
